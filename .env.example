# Copy to .env for local dev. On Vercel, add the same keys under Project → Settings → Environment Variables
# (required at build time — Vite inlines VITE_* into the bundle).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Supabase Dashboard → Authentication → URL Configuration — add these redirect URLs:
#   http://localhost:8080/auth/callback
#   https://YOUR_VERCEL_DOMAIN/auth/callback
# Site URL (production): https://YOUR_VERCEL_DOMAIN
